from collections import deque
import heapq
import itertools
import math


grid = [
    ['S', '.', '.', '#', '.', '.'],
    ['.', '#', '.', '#', '.', '.'],
    ['.', '#', '.', '.', '.', '#'],
    ['.', '#', '#', '#', '.', '.'],
    ['.', '.', '.', '#', '.', '.'],
    ['.', '.', '.', '.', '.', 'G']
]

START = (0, 0)
GOAL = (5, 5)

# Up, Down, Left, Right
DIRECTIONS = [
    (-1, 0),
    (1, 0),
    (0, -1),
    (0, 1)
]


def get_neighbors(grid, node):
    r, c = node
    result = []

    for dr, dc in DIRECTIONS:
        nr = r + dr
        nc = c + dc

        if (
            0 <= nr < len(grid)
            and 0 <= nc < len(grid[0])
            and grid[nr][nc] != '#'
        ):
            result.append((nr, nc))

    return result


def build_path(parent, goal):
    path = []
    current = goal

    while current is not None:
        path.append(current)
        current = parent[current]

    return path[::-1]



def bfs(grid, start=START, goal=GOAL):
    queue = deque([start])
    parent = {start: None}

    expanded = 0

    while queue:
        current = queue.popleft()

        if current == goal:
            path = build_path(parent, goal)

            return path, len(path) - 1, expanded

        expanded += 1

        for neighbor in get_neighbors(grid, current):

            if neighbor not in parent:
                parent[neighbor] = current
                queue.append(neighbor)

    return None, None, expanded



def dfs(grid, start=START, goal=GOAL):

    visited = set()
    parent = {start: None}

    expanded = 0

    def visit(current):
        nonlocal expanded

        if current == goal:
            return True

        visited.add(current)
        expanded += 1

        for neighbor in get_neighbors(grid, current):

            if neighbor not in visited:
                parent[neighbor] = current

                if visit(neighbor):
                    return True

        return False

    solved = visit(start)

    if solved:
        path = build_path(parent, goal)

        return path, len(path) - 1, expanded

    return None, None, expanded



def ucs(grid, start=START, goal=GOAL):

    counter = itertools.count()

    queue = [
        (0, next(counter), start)
    ]

    g = {start: 0}
    parent = {start: None}

    closed = set()

    expanded = 0

    while queue:

        cost, _, current = heapq.heappop(queue)

        if current in closed:
            continue

        if current == goal:

            return (
                build_path(parent, goal),
                cost,
                expanded
            )

        closed.add(current)

        expanded += 1

        for neighbor in get_neighbors(grid, current):

            new_cost = cost + 1

            if new_cost < g.get(neighbor, math.inf):

                g[neighbor] = new_cost
                parent[neighbor] = current

                heapq.heappush(
                    queue,
                    (
                        new_cost,
                        next(counter),
                        neighbor
                    )
                )

    return None, None, expanded



def manhattan(node, goal=GOAL):

    return (
        abs(node[0] - goal[0])
        +
        abs(node[1] - goal[1])
    )


def astar(grid, start=START, goal=GOAL):

    counter = itertools.count()

    start_h = manhattan(start, goal)

    queue = [
        (
            start_h,
            start_h,
            next(counter),
            start
        )
    ]

    g = {start: 0}
    parent = {start: None}

    closed = set()

    expanded = 0

    while queue:

        f, h, _, current = heapq.heappop(queue)

        if current in closed:
            continue

        if current == goal:

            return (
                build_path(parent, goal),
                g[goal],
                expanded
            )

        closed.add(current)

        expanded += 1

        for neighbor in get_neighbors(grid, current):

            new_g = g[current] + 1

            if new_g < g.get(neighbor, math.inf):

                g[neighbor] = new_g
                parent[neighbor] = current

                h = manhattan(neighbor, goal)
                f = new_g + h

                heapq.heappush(
                    queue,
                    (
                        f,
                        h,
                        next(counter),
                        neighbor
                    )
                )

    return None, None, expanded



print("=== БАСТАПҚЫ ТОР ===")

for name, algorithm in [
    ("DFS", dfs),
    ("BFS", bfs),
    ("UCS", ucs),
    ("A*", astar)
]:

    path, cost, expanded = algorithm(grid)

    print("\n", name)

    print("Path:", path)
    print("Cost:", cost)
    print("Expanded:", expanded)



def distances(grid, source):

    queue = deque([source])

    dist = {source: 0}

    while queue:

        current = queue.popleft()

        for neighbor in get_neighbors(grid, current):

            if neighbor not in dist:

                dist[neighbor] = dist[current] + 1
                queue.append(neighbor)

    return dist


dist_start = distances(grid, START)
dist_goal = distances(grid, GOAL)

states = [
    (0, 0),
    (0, 2),
    (2, 2),
    (3, 5),
    (5, 4)
]

print("\n=== HEURISTIC ANALYSIS ===")

for state in states:

    g_value = dist_start[state]
    h_value = manhattan(state)
    f_value = g_value + h_value

    actual = dist_goal[state]

    admissible = h_value <= actual

    print(
        state,
        "g =", g_value,
        "h =", h_value,
        "f =", f_value,
        "actual =", actual,
        "admissible =", admissible
    )



