STATES = ("A", "B", "C", "D", "E", "S", "F", "H", "I")
ACTIONS = ("UP", "DOWN", "LEFT", "RIGHT")
TERMINALS = ("G", "X")
POSITIONS = {
    "A": (0, 0), "B": (0, 1), "C": (0, 2), "G": (0, 3),
    "D": (1, 0),                 "E": (1, 2), "X": (1, 3),
    "S": (2, 0), "F": (2, 1), "H": (2, 2), "I": (2, 3),
}
STATE_AT = {pos: state for state, pos in POSITIONS.items()}
MOVES = {"UP": (-1, 0), "DOWN": (1, 0),
         "LEFT": (0, -1), "RIGHT": (0, 1)}
SIDES = {"UP": ("LEFT", "RIGHT"), "DOWN": ("RIGHT", "LEFT"),
         "LEFT": ("DOWN", "UP"), "RIGHT": ("UP", "DOWN")}


def move(state, direction):
    row, col = POSITIONS[state]
    dr, dc = MOVES[direction]
    return STATE_AT.get((row + dr, col + dc), state)


def transitions(state, action, p_main=0.8, r_x=-10.0, r_step=-0.1):
    # A terminal state has no further reward or movement.
    if state in TERMINALS:
        return [(1.0, state, 0.0)]
    if not 0.0 <= p_main <= 1.0:
        raise ValueError("p_main must be between 0 and 1")
    p_side = (1.0 - p_main) / 2.0
    directions = (action,) + SIDES[action]
    probabilities = (p_main, p_side, p_side)
    combined = {}
    for direction, probability in zip(directions, probabilities):
        next_state = move(state, direction)
        combined[next_state] = combined.get(next_state, 0.0) + probability
    return [(probability, next_state,
             10.0 if next_state == "G" else
             r_x if next_state == "X" else r_step)
            for next_state, probability in combined.items()]


def q_value(state, action, values, gamma, p_main, r_x, r_step):
    return sum(prob * (reward + gamma * values.get(next_state, 0.0))
               for prob, next_state, reward in
               transitions(state, action, p_main, r_x, r_step))


def value_iteration(gamma=0.9, p_main=0.8, r_x=-10.0,
                    r_step=-0.1, theta=0.001):
    if not 0.0 <= gamma < 1.0 or theta <= 0.0:
        raise ValueError("Require 0 <= gamma < 1 and theta > 0")
    values = {state: 0.0 for state in STATES}
    history = [values.copy()]
    for iteration in range(1, 100001):
        # Every update uses the previous iteration's values.
        new_values = {
            state: max(q_value(state, action, values, gamma,
                               p_main, r_x, r_step) for action in ACTIONS)
            for state in STATES
        }
        delta = max(abs(new_values[s] - values[s]) for s in STATES)
        values = new_values
        history.append(values.copy())
        if delta < theta:
            break
    else:
        raise RuntimeError("Value iteration did not converge")
    all_q = {
        s: {a: q_value(s, a, values, gamma, p_main, r_x, r_step)
            for a in ACTIONS} for s in STATES
    }
    policy = {s: max(ACTIONS, key=all_q[s].get) for s in STATES}
    return values, policy, all_q, history, iteration, delta


def discounted_return(rewards, gamma):
    return sum(gamma ** t * reward for t, reward in enumerate(rewards))


def main():
    print("TASK 2: TRANSITIONS")
    for state in ("F", "E", "C"):
        for probability, next_state, reward in transitions(state, "RIGHT"):
            print(f"{state} RIGHT: {next_state}, p = {probability:.3f}, "
                  f"reward = {reward:g}")
    print("\nTASK 3: DISCOUNTED RETURNS")
    for rewards, gamma in (([2, 4, 6], 0.5), ([2, 4, 6], 0.9),
                           ([0, 0, 10], 0.5)):
        print(rewards, "gamma =", gamma,
              "U =", discounted_return(rewards, gamma))
    values, policy, all_q, history, count, delta = value_iteration()
    print("\nV0, V1, V2")
    for s in STATES:
        print(s, *(f"{history[k][s]:.6f}" for k in range(3)))
    print(f"\nBASELINE: iterations = {count}, delta = {delta:.9f}")
    print("state       V       UP       DOWN       LEFT       RIGHT  policy")
    for s in STATES:
        qs = " ".join(f"{all_q[s][a]:10.6f}" for a in ACTIONS)
        print(f"{s:>3} {values[s]:10.6f} {qs}  {policy[s]}")
    print("G: V = 0, terminal; entry reward = +10")
    print("X: V = 0, terminal; entry reward = -10")
    experiments = (
        ("gamma = 0.2", {"gamma": 0.2}),
        ("p_main = 0.6", {"p_main": 0.6}),
        ("r_x = -30", {"r_x": -30.0}),
        ("r_step = -1", {"r_step": -1.0}),
    )
    for label, params in experiments:
        v, pi, _, _, n, d = value_iteration(**params)
        print(f"\nEXPERIMENT: {label}; iterations = {n}; delta = {d:.9f}")
        for s in STATES:
            changed = " (changed)" if pi[s] != policy[s] else ""
            print(f"{s}: V = {v[s]:.6f}, action = {pi[s]}{changed}")


if __name__ == "__main__":
    main()
