from collections import deque


def dfs(start, goal):
    stack = [(start, [start])]
    seen, order = set(), []

    while stack:
        node, path = stack.pop()

        if node in seen:
            continue

        seen.add(node)
        order.append(node)

        if node == goal:
            return order, path

        for nxt, _ in reversed(graph[node]):
            if nxt not in seen:
                stack.append((nxt, path + [nxt]))

    return order, None


def bfs(start, goal):
	q = deque([(start, [start])])
	seen, order = {start}, []

	while q:
		node, path = q.popleft()
		order.append(node)

		if node == goal:
			return order, path

		for nxt, _ in graph[node]:
			if nxt not in seen:
				seen.add(nxt)
				q.append((nxt, path + [nxt]))

	return order, []



