def ucs(start, goal, graph):
   pq = [(0, start, [start])]
   best = {start: 0}
   order = []

   while pq:
      g, node, path = heappop(pq)

      if g != best[node]:
         continue

      order.append(node)
      if node == goal:
         return order, path, g

      for nxt, cost in graph[node]:
         ng = g + cost
         if ng < best.get(nxt, float("inf")):
            best[nxt] = ng
            heappush(pq, (ng, nxt, path + [nxt]))

   return order, [], float("inf")

