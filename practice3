def hill_climbing(values, start):
    """Move to the neighboring value that is strictly higher."""
    index = start

    while True:
        neighbors = []
        if index > 0:
            neighbors.append(index - 1)
        if index < len(values) - 1:
            neighbors.append(index + 1)

        higher = [neighbor for neighbor in neighbors if values[neighbor] > values[index]]
        if not higher:
            return index

        index = max(higher, key=lambda neighbor: values[neighbor])


