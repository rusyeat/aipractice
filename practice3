def hill_climbing(values, start):
    current = start

    while True:
        neighbors = []

        if current > 0:
            neighbors.append(current - 1)

        if current < len(values) - 1:
            neighbors.append(current + 1)

        best = current

        for n in neighbors:
            if values[n] > values[best]:
                best = n

        if best == current:
            break

        current = best

    return current

